# 베이스 이미지
FROM node:20-alpine

# 작업폴더
WORKDIR /app

# Corepack 활성화 → Yarn 4 자동 사용
RUN corepack enable

# Yarn 설정(캐시 호환)
ENV YARN_NODE_LINKER=node-modules

# (필요 시) Node 20+ OpenSSL 옵션
# ENV NODE_OPTIONS=--openssl-legacy-provider

# 의존성 파일만 복사 → 캐시 활용
COPY package.json yarn.lock ./

# 의존성 설치 (lockfile 고정)
RUN yarn install --immutable

# 애플리케이션 소스 복사
COPY . .

# 서비스 포트
EXPOSE 5173

# Dev 서버 실행
CMD ["yarn", "dev", "--host", "0.0.0.0"]
