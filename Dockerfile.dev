# 1️⃣ 베이스 이미지는 node:20-bullseye-slim
FROM node:20-alpine

# 2️⃣ 컨테이너 작업 디렉터리 설정
WORKDIR /app

# 3️⃣ Yarn이 node_modules를 symlink 대신
#    로컬폴더에 직접 설치하도록 강제
ENV YARN_NODE_LINKER=node-modules

# 4️⃣ Node 20+ 버전에서 일부 네이티브 바이너리 설치 충돌 방지
ENV NODE_OPTIONS=--openssl-legacy-provider

# 5️⃣ package.json / yarn.lock 복사
COPY package.json yarn.lock ./

# 6️⃣ 의존성 설치
#    --frozen-lockfile: yarn.lock 그대로
#    여기서 esbuild 대신 esbuild-wasm, react-hook-form 등도 함께 설치
RUN yarn set version stable \
  && yarn config set enableImmutableInstalls false \
  && yarn config set nodeLinker node-modules \
  && yarn install --frozen-lockfile \
  && yarn add esbuild-wasm react-hook-form yup @hookform/resolvers

# 7️⃣ 로컬 소스코드 복사
COPY . .

# 8️⃣ Vite 개발 서버 포트
EXPOSE 5173

# 9️⃣ 컨테이너 실행 시 Vite dev 서버 띄우기
CMD ["yarn", "dev", "--host", "0.0.0.0"]
